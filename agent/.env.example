# ============================================
# RWA Fund Agent Configuration
# ============================================

# --- API Keys ---

# OpenAI API (required for LangChain agent)
OPENAI_API_KEY=sk-proj-...

# Dinari API (https://partners.dinari.com/)
DINARI_API_KEY=your_dinari_api_key

# --- Agent Wallets ---

# Agent wallet on Base (KYC'd, holds real dShares)
# This wallet is KYC'd with Dinari and holds the actual dShares
AGENT_PRIVATE_KEY=0x...

# Oracle wallet on Casper (signs NAV updates)
ORACLE_PRIVATE_KEY=0x...

# --- Blockchain RPC URLs ---

# Base Mainnet
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia (testnet)
# BASE_RPC_URL=https://sepolia.base.org

# Casper Mainnet
CASPER_RPC_URL=https://rpc.mainnet.casperlabs.io

# Casper Testnet
# CASPER_RPC_URL=https://rpc.testnet.casperlabs.io

# --- Contract Addresses ---

# AgentPortfolioReporter on Base
AGENT_PORTFOLIO_REPORTER_ADDRESS=0x...

# Fund contract hash on Casper (format: hash-xxxxx...)
FUND_CONTRACT_HASH=hash-...

# --- Optional ---

# For subscription mode (cron)
# NAV_UPDATE_INTERVAL_MS=60000  # 1 minute
# Or use: NAV_UPDATE_INTERVAL_CRON="*/5 * * * *"  # Every 5 minutes

# Price staleness threshold (ms)
# STALENESS_THRESHOLD_MS=3600000  # 1 hour
